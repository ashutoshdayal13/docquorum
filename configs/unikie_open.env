# UNIKIE-BENCH's open-category track (1,661 documents, 8 scenarios): load it after local.env, from the
# project folder, to make benchmarks/unikie/ work on that track:  set -a; source configs/unikie_open.env; set +a
# Its datasets folder comes from the benchmark's open-category data (README, section 1).
export DQ_UNIKIE_DATASETS=$PWD/data/unikie-open/datasets
export DQ_UNIKIE_SCENARIOS=receipt-cn,Form-cn,invoice-cn,Contract-cn,receipt-en,Form-en,invoice-en,Contract-en
export DQ_UNIKIE_PCACHE=$PWD/cache/unikie_open_parse_1p6
export DQ_UNIKIE_READINGS=$PWD/results/unikie_open/readings
