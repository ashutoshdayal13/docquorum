# Copy to configs/local.env, edit, then load it in every shell:  source configs/local.env
# Only the variables you need to change must be set; these are the defaults.

# Poppler tools (pdftotext, pdftoppm, pdfinfo, pdffonts, pdfimages). Leave unset if they are on PATH.
# export DQ_POPPLER_BIN=/path/to/poppler/bin

# The extraction model: an OpenAI-compatible server (serve/serve_qwen38_27b.sh starts it here).
export DQ_LLM_URL=http://localhost:8079/v1
export DQ_MODEL_NAME=qwen3vl

# The MinerU2.5 parser (serve/serve_mineru.sh); only needed to read scans and images.
export DQ_PARSER_URL=http://localhost:8081/v1

# The Python that has this project's requirements AND llama-extract-bench (Python >= 3.12),
# used by the benchmarks/*/run.sh scripts. Default: `python` on PATH.
# export DQ_PYTHON=/path/to/venv/bin/python

# Data and outputs (defaults are folders inside the project; see README "Data")
# export DQ_EXTRACTBENCH_DATA=/path/to/docquorum/data/extractbench
# export DQ_PARSE_CACHE=/path/to/docquorum/cache/parse
# export DQ_RUNS=/path/to/docquorum/runs
# export DQ_UNIKIE_DIR=/path/to/docquorum/data/unikie-bench

# vLLM serving: the env that has vllm==0.27.1 (optional) and where models are cached
# export VLLM_ENV=/path/to/vllm-env
# export HF_HOME=/path/to/huggingface-cache
