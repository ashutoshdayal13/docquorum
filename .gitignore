# benchmark data and model/parse caches (large, third-party; see README for where to get them)
data/
cache/
# run folders and logs (reproducible with the benchmark runners)
runs/
logs/
# the benchmark papers (third-party)
ref_papers/
# Python / LaTeX build files
__pycache__/
*.pyc
.pytest_cache/
docs/*.aux
docs/*.log
docs/*.out

# machine-specific settings (copy configs/example.env)
configs/local.env

# kept locally, not published
_withheld/

# Multi-benchmark source copies, images and raw runs stay local; manifests/summaries are tracked.
results/multibench/**/inputs/
results/multibench/**/converted/
results/multibench/**/predictions/
results/multibench/**/reports/
results/multibench/**/*.csv

# earlier readings kept locally when a re-read replaces them
*.before_enlarge.json
*.before_enlarge.txt
