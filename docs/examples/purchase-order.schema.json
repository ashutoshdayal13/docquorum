{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Extract the order header and every ordered item.",
  "properties": {
    "order_number": {"type": "string", "description": "The purchase-order number as printed."},
    "supplier": {"type": "string", "description": "The supplier name as printed."},
    "items": {
      "type": "array",
      "description": "Every ordered item, in document order.",
      "items": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "quantity": {"type": "number"},
          "unit_price": {"type": "number"}
        },
        "required": ["description", "quantity", "unit_price"]
      }
    }
  },
  "required": ["order_number", "supplier", "items"]
}
